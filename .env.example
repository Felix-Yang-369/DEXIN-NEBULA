# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Use separate credentials for development, preview and production.
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use a publishable key. It is safe to expose to the browser
# only when Row Level Security is enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still use an anon key. Keep empty when publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only administrative key. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# WeCom QR sign-in (server only)
# Configure the exact callback domain in WeCom Admin -> App -> WeCom authorization login.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CALLBACK_URL=

# PostgreSQL / Prisma
# DATABASE_URL is used by the application.
# DIRECT_URL is reserved for migrations when the connection topology requires it.
DATABASE_URL=
DIRECT_URL=

# DeepSeek AI (server only)
# Create the key in the DeepSeek API console. Never expose it through NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
